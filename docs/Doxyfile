# Основные настройки проекта
PROJECT_NAME           = "UFO Console Module"
PROJECT_BRIEF          = "Console interface for embedded systems"
PROJECT_NUMBER         = "1.0"
OUTPUT_DIRECTORY       = docs/html
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = Russian
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ABBREVIATE_BRIEF       = "The $name class" \
                         "The $name widget" \
                         "The $name file" \
                         is \
                         provides \
                         specifies \
                         contains \
                         represents \
                         a \
                         an \
                         the

# Входные файлы
INPUT                  = . \
                         impl \
                         impl/Console-parser \
                         docs/examples
FILE_PATTERNS          = *.h \
                         *.dox \
                         *.cpp
RECURSIVE              = YES
EXCLUDE                = impl/Console-parser/tests.txt \
                         impl/Console-parser/main.txt \
                         impl/Console-parser/a.out \
                         impl/Console-parser/.git
EXCLUDE_PATTERNS       = */a.out \
                         */.git/*
EXCLUDE_SYMLINKS       = YES

# Настройки вывода
GENERATE_HTML          = YES
